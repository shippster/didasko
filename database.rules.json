{
  "rules": {
    ".read": false,
    ".write": false,
    "sessions": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
        ".validate": "$code.matches(/^[A-Z0-9]{6}$/)",
        "host": {
          ".validate": "newData.val() === auth.uid"
        },
        "participants": {
          "$pid": {
            ".write": "auth != null && $pid === auth.uid",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "lang": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "animal": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "reflect": {
              ".validate": "newData.isString() && newData.val().length <= 280"
            },
            "conf": {
              "$q": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
              }
            }
          }
        },
        "responses": {
          "$q": {
            "$pid": {
              ".write": "auth != null && $pid === auth.uid && !data.exists() && root.child('sessions/' + $code + '/quiz/state').val() === 'question' && root.child('sessions/' + $code + '/quiz/index').val() + '' === $q && (root.child('sessions/' + $code + '/quiz/duration').val() === 0 || now <= root.child('sessions/' + $code + '/quiz/startedAt').val() + root.child('sessions/' + $code + '/quiz/duration').val() * 1000 + 3000)",
              ".validate": "newData.hasChildren(['c']) && newData.child('c').isNumber() && newData.child('c').val() >= 0 && newData.child('c').val() <= 3"
            }
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'"
      }
    },
    "newsletter": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.hasChildren(['email']) && newData.child('email').isString()"
      }
    }
  }
}
